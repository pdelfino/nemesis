#!/usr/bin/env node
// bin/nemesis-eval (#182): runs a command or evaluates a form in the running
// cockpit from a terminal, as Nyxt's `--remote --eval` does. Plain Node, no
// dependency, no build step. It is a tiny MCP client of the socket door of
// ADR 0007, with the same token nemesis-mcp sends, and it calls one tool,
// cockpit_run_command: eval-expression, load-file and most commands are of
// class `yes`, so the app asks the user in the prompt buffer each time and
// nothing runs without that yes. A `never` command is refused as on any door.
//
//   nemesis-eval '<form>'                  eval-expression on the form
//   nemesis-eval -                         the form is read from stdin
//   nemesis-eval --load <file>             load-file on a .ts or .js file
//   nemesis-eval --command <name> [answer...]
//
// `--socket <path>` and NEMESIS_USER_DATA find the socket as in nemesis-mcp.
// The notices the run left are printed, one per line; a refusal or an error
// goes to stderr with exit status 1.
'use strict'

const net = require('node:net')
const fs = require('node:fs')
const os = require('node:os')
const path = require('node:path')

const HELLO = 'NEMESIS-MCP 1'
const PROTOCOL_VERSION = '2025-06-18'
const USAGE =
  'usage: nemesis-eval [--socket <path>] (<form> | - | --load <file> | --command <name> [answer...])\n'

function defaultUserData() {
  const home = os.homedir()
  if (process.platform === 'darwin') {
    return path.join(home, 'Library', 'Application Support', 'Nemesis')
  }
  if (process.platform === 'win32') {
    return path.join(process.env.APPDATA || path.join(home, 'AppData', 'Roaming'), 'Nemesis')
  }
  return path.join(process.env.XDG_CONFIG_HOME || path.join(home, '.config'), 'Nemesis')
}

function fail(message) {
  process.stderr.write(message.endsWith('\n') ? message : `${message}\n`)
  process.exit(1)
}

/** The socket and what to run, from argv. */
function parse(argv) {
  let socket = null
  const rest = []
  for (let i = 0; i < argv.length; i += 1) {
    if (argv[i] === '--socket' && argv[i + 1]) {
      socket = path.resolve(argv[i + 1])
      i += 1
    } else if (argv[i].startsWith('--socket=')) {
      socket = path.resolve(argv[i].slice('--socket='.length))
    } else {
      rest.push(argv[i])
    }
  }
  socket ??= path.join(process.env.NEMESIS_USER_DATA || defaultUserData(), 'mcp.sock')
  if (rest[0] === '--command' && rest[1]) {
    return { socket, name: rest[1], answers: rest.slice(2) }
  }
  if (rest[0] === '--load' && rest[1] && rest.length === 2) {
    // The app resolves a relative path against its own folder, not this one.
    return { socket, name: 'load-file', answers: [path.resolve(rest[1])] }
  }
  if (rest.length === 1 && rest[0] === '-') {
    return { socket, name: 'eval-expression', answers: [fs.readFileSync(0, 'utf8')] }
  }
  if (rest.length === 1 && !rest[0].startsWith('--')) {
    return { socket, name: 'eval-expression', answers: [rest[0]] }
  }
  fail(USAGE)
}

const run = parse(process.argv.slice(2))
let token
try {
  token = fs.readFileSync(path.join(path.dirname(run.socket), 'mcp.token'), 'utf8').trim()
} catch {
  fail('Nemesis is not running')
}

const socket = net.connect(run.socket)
let connected = false
let done = false
let pending = ''

function send(message) {
  socket.write(`${JSON.stringify({ jsonrpc: '2.0', ...message })}\n`)
}

function finish(result) {
  done = true
  const structured = result.structuredContent
  const content = Array.isArray(result.content) ? result.content : []
  const text = content.map((item) => item.text || '').join('\n')
  if (result.isError) {
    socket.end()
    fail(text || 'The call failed')
  }
  const notices = structured && Array.isArray(structured.notices) ? structured.notices : null
  process.stdout.write(`${notices === null ? text : notices.join('\n')}\n`)
  socket.end()
  process.exit(0)
}

function receive(message) {
  if (message.id === 1) {
    if (message.error) fail(`Nemesis refused the client: ${message.error.message}`)
    send({ method: 'notifications/initialized' })
    send({
      id: 2,
      method: 'tools/call',
      params: { name: 'cockpit_run_command', arguments: { name: run.name, answers: run.answers } },
    })
  } else if (message.id === 2) {
    if (message.error) fail(message.error.message)
    finish(message.result)
  }
}

socket.once('connect', () => {
  connected = true
  socket.write(`${HELLO} ${token}\n`)
  send({
    id: 1,
    method: 'initialize',
    params: {
      protocolVersion: PROTOCOL_VERSION,
      capabilities: {},
      clientInfo: { name: 'nemesis-eval', version: '1.0.0' },
    },
  })
})
socket.on('data', (chunk) => {
  pending += chunk.toString('utf8')
  let newline = pending.indexOf('\n')
  while (newline !== -1) {
    const line = pending.slice(0, newline).trim()
    pending = pending.slice(newline + 1)
    if (line.length > 0) receive(JSON.parse(line))
    newline = pending.indexOf('\n')
  }
})
socket.once('error', () => {
  if (!connected) fail('Nemesis is not running')
})
socket.once('close', () => {
  // Closed before the answer: the token of another run, most likely.
  if (!done) fail('Nemesis closed the connection: is the app the one that wrote the token?')
})
