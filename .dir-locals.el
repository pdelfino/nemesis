;;; Directory Local Variables for Nemesis           -*- emacs-lisp -*-
;;;
;;; Loaded by Emacs when visiting any file under this repo.  The canonical
;;; editor workflow for Nemesis is Emacs + racket-mode (see CONTRIBUTING.md);
;;; these defaults exist so that workflow needs no per-file configuration.
;;;
;;; The first time you open a file here Emacs will ask whether to trust these
;;; values — answer `!' to mark them safe.

((nil . ((fill-column . 80)
         (indent-tabs-mode . nil)))
 (racket-mode . ((racket-indent-sequence-depth . 1)))
 (racket-hash-lang-mode . ((racket-indent-sequence-depth . 1))))
