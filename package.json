{
  "name": "nemesis",
  "productName": "Nemesis",
  "version": "0.0.1",
  "private": true,
  "description": "A keyboard-driven cockpit for Claude Code that grows into a Nyxt-style browser. Daughter of Nyx.",
  "license": "BSD-3-Clause",
  "author": "Pedro Delfino",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test --project=app",
    "test:security": "npm run build && playwright test --project=security",
    "test": "npm run test:unit && npm run test:e2e && npm run test:security",
    "check-deps": "node scripts/check-deps.mjs",
    "agent:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/agent-smoke.mts",
    "peek": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/peek.mts",
    "gate": "npm run check-deps && npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run test:security",
    "electron:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@replit/codemirror-emacs": "6.1.0",
    "@types/node": "24.19.2",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
