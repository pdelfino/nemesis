# macOS
.DS_Store

# Node / Electron
node_modules/
dist/
out/
release/
# The release checks (#74) live in tests/release, which is source, not output
!tests/release/
*.tsbuildinfo
npm-debug.log*

# Tests
coverage/
playwright-report/
test-results/

# Local secrets and env (never committed; the SDK uses the claude CLI login)
.env
.env.*

# Editor backups
*~
.#*
\#*\#

# Claude Code per-project state (CLAUDE.md at the root is tracked)
.claude/
# The environment panel's fixture tree carries .claude folders on purpose (#86)
!tests/fixtures/environment/**/.claude/
